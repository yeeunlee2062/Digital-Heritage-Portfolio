    hmv:weaving_tool_roles "[{\"basis_status\":\"교재 확인\",\"phase_sequence\":1,\"role_description\":\"바디집을 끼워 바디를 고정하고 제직에 사용할 준비를 함\",\"role_type\":\"설치 및 준비\",\"tool_id\":\"TOL_030\",\"ui_process_id\":\"PRC_012\"},{\"basis_status\":\"교재 확인\",\"phase_sequence\":1,\"role_description\":\"가슴내기를 마친 뒤 임시 고정에 사용한 매답대를 제거함\",\"role_type\":\"설치 및 준비\",\"tool_id\":\"TOL_050\",\"ui_process_id\":\"PRC_012\"},{\"basis_status\":\"교재 확인\",\"phase_sequence\":1,\"role_description\":\"말코의 홈에 제직한 직물 끝을 넣고 고정함\",\"role_type\":\"설치 및 준비\",\"tool_id\":\"TOL_035\",\"ui_process_id\":\"PRC_012\"},{\"basis_status\":\"교재 확인\",\"phase_sequence\":1,\"role_description\":\"제직자가 부테를 허리에 감아 날실 장력을 유지함\",\"role_type\":\"지속 작용\",\"tool_id\":\"TOL_036\",\"ui_process_id\":\"PRC_012\"},{\"basis_status\":\"교재·구조도\",\"phase_sequence\":1,\"role_description\":\"부테와 말코를 연결해 장력이 유지되도록 함\",\"role_type\":\"지속 작용\",\"tool_id\":\"TOL_045\",\"ui_process_id\":\"PRC_012\"},{\"basis_status\":\"교재 확인\",\"phase_sequence\":2,\"role_description\":\"발로 끌신을 당겨 잉아올을 들어 올리고 개구 상태를 바꿈\",\"role_type\":\"직접 작용\",\"tool_id\":\"TOL_020\",\"ui_process_id\":\"PRC_013\"},{\"basis_status\":\"교재 확인\",\"phase_sequence\":2,\"role_description\":\"잉앗대의 상하 움직임을 통해 잉아올의 위치를 변화시킴\",\"role_type\":\"직접 작용\",\"tool_id\":\"TOL_023\",\"ui_process_id\":\"PRC_013\"},{\"basis_status\":\"교재 확인\",\"phase_sequence\":2,\"role_description\":\"비거미가 잉아올과 사올을 분리하여 자연개구를 형성함\",\"role_type\":\"지속 작용\",\"tool_id\":\"TOL_025\",\"ui_process_id\":\"PRC_013\"},{\"basis_status\":\"교재 확인\",\"phase_sequence\":2,\"role_description\":\"누름대가 개구 시 사올이 함께 올라가는 것을 억제함\",\"role_type\":\"지속 작용\",\"tool_id\":\"TOL_026\",\"ui_process_id\":\"PRC_013\"},{\"basis_status\":\"구조도 기반\",\"phase_sequence\":2,\"role_description\":\"하부 잉앗대가 잉앗줄과 연결된 개구 장치를 지지함\",\"role_type\":\"지속 작용\",\"tool_id\":\"TOL_049\",\"ui_process_id\":\"PRC_013\"},{\"basis_status\":\"교재 확인\",\"phase_sequence\":3,\"role_description\":\"북을 날실 사이로 통과시켜 씨실을 투입함\",\"role_type\":\"직접 작용\",\"tool_id\":\"TOL_028\",\"u