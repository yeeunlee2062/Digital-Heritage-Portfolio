            sh:nodeKind sh:IRI ;
            sh:path hmv:parent_tool_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "요소세부설명"@ko ;
            sh:path hmv:description ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "요소유형"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path hmv:component_type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "도구ID"@ko ;
            sh:path hmv:tool_id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "이칭"@ko ;
            sh:path hmv:alternative_name ] ;
    sh:targetClass hmv:Tool .

hms:Transmitter a sh:NodeShape ;
    rdfs:comment "스키마 시트 03_Transmitter의 필수 여부, 입력 유형, 키/참조"@ko ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "전승자ID"@ko ;
            sh:path hmv:transmitter_id ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:name "기예능"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path hmv:specialty ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:name "인정일"@ko ;
            sh:path hmv:recognized_date ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "해제 사유"@ko ;
            sh:path hmv:release_reason ],
        [ sh:class hmv:Agent ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "주체참조"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path hmv:agent_ref ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:name "보유구분"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path hmv:holder_type ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:name "해제일"@ko ;
            sh:path hmv:released_date ],
        [ sh:class hmv:Heritage ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "전승종목"@ko ;
            sh:nodeKind sh:IRI ;
            sh:path hmv:heritage_ref ] ;
    sh:targetClass hmv:Transmitter .

