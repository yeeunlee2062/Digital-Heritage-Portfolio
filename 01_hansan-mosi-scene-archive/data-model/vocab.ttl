    hmv:schema_relation_row 15 ;
    hmv:schema_version "4차" ;
    hmv:source_fields "Movement.process_ref" .

hmv:CONCERNS_PROCESS a owl:ObjectProperty ;
    rdfs:label "concerns process"@en,
        "대상으로 하다"@ko ;
    rdfs:comment "Performance → Process: 제작공정을 실제로 수행하거나 기록한 Performance를 해당 Process와 연결하는 관계이며, 인터뷰·구술처럼 공정이 수행되지 않은 사건에는 적용하지 않음"@ko ;
    rdfs:domain hmv:Performance ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:range hmv:Process ;
    hmv:assertion_status "ASSERTED" ;
    hmv:dataset_id "HANSAN_MOSI_V4" ;
    hmv:definitionStatus "MATERIALIZED" ;
    hmv:derivation_basis "direct_reference" ;
    hmv:relationship_context "행위적 맥락" ;
    hmv:relationship_definition "제작공정을 실제로 수행하거나 기록한 Performance를 해당 Process와 연결하는 관계이며, 인터뷰·구술처럼 공정이 수행되지 않은 사건에는 적용하지 않음" ;
    hmv:schemaRow 31 ;
    hmv:schema_relation_row 31 ;
    hmv:schema_version "4차" ;
    hmv:source_fields "Performance.process_refs" .

