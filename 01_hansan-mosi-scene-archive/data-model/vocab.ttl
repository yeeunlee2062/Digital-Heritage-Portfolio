hmv:ACTS_IN_MOVEMENT a owl:ObjectProperty ;
    rdfs:label "acts in movement"@en,
        "동작에 작용하다"@ko ;
    rdfs:comment "Tool → Movement: 도구가 특정 Movement에서 직접 기능하는 역방향 의미 관계이며 Tool에는 별도 Movement FK를 저장하지 않음"@ko ;
    rdfs:domain hmv:Tool ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:range hmv:Movement ;
    hmv:assertion_status "DERIVED_INVERSE" ;
    hmv:dataset_id "HANSAN_MOSI_V4" ;
    hmv:definitionStatus "MATERIALIZED" ;
    hmv:derivation_basis "inverse_of_operates_tool" ;
    hmv:relationship_context "상호작용 맥락" ;
    hmv:relationship_definition "도구가 특정 Movement에서 직접 기능하는 역방향 의미 관계이며 Tool에는 별도 Movement FK를 저장하지 않음" ;
    hmv:schemaRow 23 ;
    hmv:schema_relation_row 23 ;
    hmv:schema_version "4차" ;
    hmv:source_fields "Movement.tool_refs" .

hmv:ACTS_ON_MATERIAL a owl:ObjectProperty ;
    rdfs:label "acts on material"@en,
        "재료에 작용하다"@ko ;
    rdfs:comment "Movement → Materials: 특정 동작이 재료의 위치, 배열, 장력 또는 상태에 직접 영향을 주는 관계이며 실제 FK는 Movement.material_refs에 저장"@ko ;
    rdfs:domain hmv:Movement ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:range hmv:Materials ;
    hmv:assertion_status "ASSERTED" ;
    hmv:dataset_id "HANSAN_MOSI_V4" ;
    hmv:definitionStatus "MATERIALIZED" ;
    hmv:derivation_basis "direct_reference" ;
    hmv:relationship_context "상호작용 맥락" ;
    hmv:relationship_definition "특정 동작이 재료의 위치, 배열, 장력 또는 상태에 직접 영향을 주는 관계이며 실제 FK는 Movement.material_refs에 저장" ;
    hmv:schemaRow 24 ;
    hmv:schema_relation_row 24 ;
    hmv:schema_version "4차" ;
    hmv:source_fields "Movement.material_refs" .

hmv:APPLIES_TO_ASSET a owl:ObjectProperty ;
    rdfs:label "applies to asset"@en,
        "적용되다"@ko ;
    rdfs:comment "Licence → Asset: 특정 이용허락 조건이 하나 이상의 디지털 애셋에 적용되는 관계"@ko,
        "Right → Asset: 특정 권리가 하나 이상의 디지털 애셋에 적용되는 직접 관계이며 실제 FK는 Right.asset_refs에 저장"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:range hmv:Asset ;
    hmv:assertion_status "ASSERTED" ;
    hmv:dataset_id "HANSAN_MOSI_V4" ;
    hmv:definitionStatus "MATERIALIZED" ;
    hmv:derivation_basis "direct_reference" ;
    hmv:schemaRow 50,
        54 ;
    hmv:schema_version "4차" .

hmv:ARISES_FROM_PERFORMANCE a owl:ObjectProperty ;
    rdfs:label "arises from performance"@en,
        "실연에서 발생하다"@ko ;
    rdfs:comment "Right → Performance: 특정 권리가 어느 실연 사건과 관련하여 발생하였는지를 나타내는 관계"@ko ;
    rdfs:domain hmv:Right ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:range hmv:Performance ;
    hmv:assertion_status "DERIVED_PATH" ;
    hmv:dataset_id "HANSAN_MOSI_V4" ;
    hmv:definitionStatus "MATERIALIZED" ;
    hmv:derivation_basis "shared_asset_path_inverse" ;
    hmv:relationship_context "권리 맥락" ;
    hmv:relationship_definition "특정 권리가 어느 실연 사건과 관련하여 발생하였는지를 나타내는 관계" ;
    hmv:schemaRow 49 ;
    hmv:schema_relation_row 49 ;
    hmv:schema_version "4차" ;
    hmv:source_fields "Performance.asset_refs ∩ Right.asset_refs" .

hmv:BELONGS_TO_ASSET a owl:ObjectProperty ;
    rdfs:label "belongs to asset"@en,
        "애셋에 속하다"@ko ;
    rdfs:comment "Item → Asset: 개별 파일 또는 서비스 표현이 특정 Asset의 구성요소가 되는 관계"@ko ;
    rdfs:domain hmv:Item ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:range hmv:Asset ;
    rdfs:subPropertyOf dcterms:isPartOf ;
    hmv:assertion_status "ASSERTED" ;
    hmv:dataset_id "HANSAN_MOSI_V4" ;
    hmv:definitionStatus "MATERIALIZED" ;
    hmv:derivation_basis "direct_reference" ;
    hmv:relationship_context "디지털 맥락" ;
    hmv:relationship_definition "개별 파일 또는 서비스 표현이 특정 Asset의 구성요소가 되는 관계" ;
    hmv:schemaRow 39 ;
    hmv:schema_relation_row 39 ;
    hmv:schema_version "4차" ;
    hmv:source_fields "Item.asset_ref" .

hmv:BELONGS_TO_PROCESS a owl:ObjectProperty ;
    rdfs:label "belongs to process"@en,
        "공정에 속하다"@ko ;
    rdfs:comment "Movement → Process: 개별 동작이 특정 제작공정의 수행 단위로 포함되는 직접 관계이며 실제 FK는 Movement.process_ref에 저장"@ko ;
