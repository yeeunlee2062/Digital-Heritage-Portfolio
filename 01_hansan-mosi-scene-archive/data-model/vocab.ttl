hmv:access.status a owl:DatatypeProperty ;
    rdfs:label "접근 상태"@ko ;
    rdfs:comment "Item: open(공개 파일 또는 원 소장처에서 받음) 또는 on_request(요청 시 제공)"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:accessRights ;
    hmv:fieldSource "시스템 생성(P30)" ;
    hmv:inputType "Item: enum" ;
    hmv:requirement "Item: 필수" ;
    hmv:usedInClass hmv:Item .

hmv:address a owl:DatatypeProperty ;
    rdfs:label "주소"@ko ;
    rdfs:comment "Place: 공간의 도로명, 지번 등 상세 주소"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:spatial ;
    skos:relatedMatch crm:E53_Place ;
    hmv:cidocCrmMapping "Place: E53 Place" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Place: string" ;
    hmv:requirement "Place: 선택" ;
    hmv:usedInClass hmv:Place .

hmv:agent_id a owl:DatatypeProperty ;
    rdfs:label "주체ID"@ko ;
    rdfs:comment "Agent: 디지털화 및 권리관계에 참여하는 개인 또는 조직을 식별하는 고유 ID"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:identifier ;
    skos:relatedMatch crm:E42_Identifier ;
    hmv:cidocCrmMapping "Agent: E42 Identifier" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Agent: string" ;
    hmv:requirement "Agent: 필수" ;
    hmv:usedInClass hmv:Agent .

hmv:agent_ref a owl:ObjectProperty ;
    rdfs:label "주체참조"@ko ;
    rdfs:comment "Transmitter: 해당 전승자 역할을 수행하는 개인 또는 조직의 Agent ID"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:relation ;
    skos:relatedMatch crm:E39_Actor ;
    hmv:cidocCrmMapping "Transmitter: E39 Actor" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Transmitter: string" ;
    hmv:requirement "Transmitter: 필수" ;
    hmv:usedInClass hmv:Transmitter .

hmv:agent_type a owl:ObjectProperty ;
    rdfs:label "주체유형"@ko ;
    rdfs:comment "Agent: 주체를 개인 또는 조직으로 구분하는 기본 유형"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:type ;
    skos:relatedMatch crm:E55_Type ;
    hmv:cidocCrmMapping "Agent: E55 Type" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Agent: string" ;
    hmv:requirement "Agent: 필수" ;
    hmv:usedInClass hmv:Agent .

hmv:agreement_document_url a owl:ObjectProperty ;
    rdfs:label "근거계약링크"@ko ;
    rdfs:comment "Right: 근거계약유형에 해당하는 실물 계약서 또는 동의서를 관리하는 외부 문서 저장소의 접근 링크"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:references ;
    skos:relatedMatch crm:E73_Information_Object ;
    hmv:cidocCrmMapping "Right: E73 Information Object" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Right: URL" ;
    hmv:requirement "Right: 선택" ;
    hmv:usedInClass hmv:Right .

hmv:agreement_type a owl:ObjectProperty ;
    rdfs:label "근거계약유형"@ko ;
    rdfs:comment "Right: 재산권 양도계약, 이용허락계약, 초상 및 음성 이용동의, 공동소유 합의, 소유권 이전계약 등 권리 상태의 계약 유형"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:type ;
    skos:relatedMatch crm:E55_Type ;
    hmv:cidocCrmMapping "Right: E55 Type" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Right: string" ;
    hmv:requirement "Right: 선택" ;
    hmv:usedInClass hmv:Right .

hmv:alternative_name a owl:DatatypeProperty ;
    rdfs:label "이칭"@ko ;
    rdfs:comment "Agent: 영문명, 약칭 또는 기타 통용 명칭"@ko,
        "Tool: 전통베틀 부재의 통용 이칭과 서천 지역에서 사용되는 명칭"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:alternative ;
    skos:relatedMatch crm:E41_Appellation ;
    hmv:cidocCrmMapping "Agent: E41 Appellation",
        "Tool: E41 Appellation" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Agent: array<string>",
        "Tool: string" ;
    hmv:requirement "Agent: 선택",
        "Tool: 선택" ;
    hmv:usedInClass hmv:Agent,
        hmv:Tool .

hmv:anchor a owl:DatatypeProperty ;
    rdfs:label "부재 앵커"@ko ;
    rdfs:comment "사용자 주석 anchors.json"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    hmv:fieldSource "웹 보조 패치·주석" .

hmv:annotated_on a owl:DatatypeProperty ;
    rdfs:label "주석 일자"@ko ;
    rdfs:comment "동작 주석(segments.json)이 REFERENCES_MOVEMENT 관계에 붙이는 속성(rdf:Statement 로 내보냄)"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    hmv:fieldSource "웹 보조 패치·주석" .

hmv:annotation_evidence a owl:DatatypeProperty ;
    rdfs:label "주석 근거"@ko ;
    rdfs:comment "동작 주석(segments.json)이 REFERENCES_MOVEMENT 관계에 붙이는 속성(rdf:Statement 로 내보냄)"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    hmv:fieldSource "웹 보조 패치·주석" .

hmv:assertion_status a owl:AnnotationProperty ;
    rdfs:label "단언 상태"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> .

hmv:asset_id a owl:DatatypeProperty ;
    rdfs:label "애셋ID"@ko ;
    rdfs:comment "Asset: 논리적 디지털 애셋의 고유 식별자"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:identifier ;
    skos:relatedMatch crm:E42_Identifier ;
    hmv:cidocCrmMapping "Asset: E42 Identifier" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Asset: string" ;
    hmv:requirement "Asset: 필수" ;
    hmv:usedInClass hmv:Asset .

hmv:asset_ref a owl:ObjectProperty ;
    rdfs:label "소속애셋"@ko ;
    rdfs:comment "Item: 아이템이 속한 상위 디지털 애셋의 ID"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:relation ;
    skos:relatedMatch crm:E73_Information_Object ;
    hmv:cidocCrmMapping "Item: E73 Information Object" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Item: string" ;
    hmv:requirement "Item: 필수" ;
    hmv:usedInClass hmv:Item .

hmv:asset_refs a owl:ObjectProperty ;
    rdfs:label "산출애셋"@ko,
        "적용애셋"@ko ;
    rdfs:comment "DigitalProject: 해당 디지털화 사업에서 생산된 애셋 ID 목록"@ko,
        "Licence: 해당 이용허락이 적용되는 디지털 애셋의 ID 목록"@ko,
        "Performance: 해당 실연 또는 촬영 사건으로부터 직접 생성된 디지털 애셋의 ID 목록"@ko,
        "Right: 해당 권리가 적용되는 디지털 애셋의 ID 목록"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:relation ;
    skos:relatedMatch crm:E73_Information_Object ;
    hmv:cidocCrmMapping "DigitalProject: E73 Information Object",
        "Licence: E73 Information Object (참조 후보)",
        "Performance: E73 Information Object",
        "Right: E73 Information Object (참조 후보)" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "DigitalProject: array<ID>",
        "Licence: array<ID>",
        "Performance: array<ID>",
        "Right: array<ID>" ;
    hmv:requirement "DigitalProject: 선택",
        "Licence: 필수",
        "Performance: 선택",
        "Right: 필수" ;
    hmv:usedInClass hmv:DigitalProject,
        hmv:Licence,
        hmv:Performance,
        hmv:Right .

hmv:asset_type a owl:ObjectProperty ;
    rdfs:label "애셋유형"@ko ;
    rdfs:comment "Asset: 이미지, 영상, 문서, 3D 모델, 4D 볼류메트릭 등의 자료 유형"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:type ;
    skos:relatedMatch crm:E55_Type ;
    hmv:cidocCrmMapping "Asset: E55 Type" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Asset: string" ;
    hmv:requirement "Asset: 필수" ;
    hmv:usedInClass hmv:Asset .

hmv:attribution_required a owl:DatatypeProperty ;
    rdfs:label "출처표시여부"@ko ;
    rdfs:comment "Licence: 애셋 이용 시 권리자 또는 출처 표시가 필요한지 여부"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:rights ;
    skos:relatedMatch crm:E55_Type ;
    hmv:cidocCrmMapping "Licence: E55 Type" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Licence: boolean" ;
    hmv:requirement "Licence: 선택" ;
    hmv:usedInClass hmv:Licence .

hmv:cidocCrmMapping a owl:AnnotationProperty ;
    rdfs:label "CIDOC-CRM 대응(스키마 시트)"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> .

hmv:classification a owl:ObjectProperty ;
    rdfs:label "공정분류"@ko,
        "분류"@ko ;
    rdfs:comment "Heritage: 유산의 상위 유형과 세부 분류를 나타내는 분류어 목록"@ko,
        "Process: 제사, 정경, 제직준비 및 제직으로 제작 단계의 기능적 범주를 구분하는 값"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:type ;
    skos:relatedMatch crm:E55_Type ;
    hmv:cidocCrmMapping "Heritage: E55 Type",
        "Process: E55 Type" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Heritage: array<string>",
        "Process: string" ;
    hmv:requirement "Heritage: 선택",
        "Process: 필수" ;
    hmv:usedInClass hmv:Heritage,
        hmv:Process .

hmv:commercial_use_allowed a owl:DatatypeProperty ;
    rdfs:label "상업적 사용여부"@ko ;
    rdfs:comment "Licence: 영리 목적의 애셋 이용을 허용하는지 여부"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:accessRights ;
    skos:relatedMatch crm:E55_Type ;
    hmv:cidocCrmMapping "Licence: E55 Type" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Licence: boolean" ;
    hmv:requirement "Licence: 선택" ;
    hmv:usedInClass hmv:Licence .

hmv:component_type a owl:ObjectProperty ;
    rdfs:label "요소유형"@ko ;
    rdfs:comment "Tool: 제작도구, 구조부재, 작동부재, 연결부재, 개구부재, 장력부재 등 기능과 구조에 따른 구분"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:type ;
    skos:relatedMatch crm:E55_Type ;
    hmv:cidocCrmMapping "Tool: E55 Type" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Tool: string" ;
    hmv:requirement "Tool: 필수" ;
    hmv:usedInClass hmv:Tool .

hmv:confirmed_at a owl:DatatypeProperty ;
    rdfs:label "확인 일자"@ko ;
    rdfs:comment "동작 주석(segments.json)이 REFERENCES_MOVEMENT 관계에 붙이는 속성(rdf:Statement 로 내보냄)"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    hmv:fieldSource "웹 보조 패치·주석" .

hmv:confirmed_by a owl:DatatypeProperty ;
    rdfs:label "확인자"@ko ;
    rdfs:comment "동작 주석(segments.json)이 REFERENCES_MOVEMENT 관계에 붙이는 속성(rdf:Statement 로 내보냄)"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    hmv:fieldSource "웹 보조 패치·주석" .

hmv:coordinates a owl:DatatypeProperty ;
    rdfs:label "위경도"@ko ;
    rdfs:comment "Place: 위도, 경도 위치 좌표로 현재 표기는 도분 기호를 포함한 문자열"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:spatial ;
    skos:relatedMatch crm:E53_Place ;
    hmv:cidocCrmMapping "Place: E53 Place" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Place: string" ;
    hmv:requirement "Place: 선택" ;
    hmv:usedInClass hmv:Place .

hmv:cycle_order a owl:DatatypeProperty ;
    rdfs:label "반복 순서"@ko ;
    rdfs:comment "동작 주석(segments.json)이 REFERENCES_MOVEMENT 관계에 붙이는 속성(rdf:Statement 로 내보냄)"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    hmv:fieldSource "웹 보조 패치·주석" .

hmv:dataset_id a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "데이터셋 ID"@ko ;
    rdfs:comment "KG 데이터셋 ID"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    hmv:fieldSource "KG 재생성 스크립트" .

hmv:date a owl:DatatypeProperty ;
    rdfs:label "실연일자"@ko ;
    rdfs:comment "Performance: 실연 또는 촬영이 수행된 날짜로 ISO 형식 정규화 권장"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:date ;
    skos:relatedMatch crm:E52_Time-Span ;
    hmv:cidocCrmMapping "Performance: E52 Time-Span" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Performance: date" ;
    hmv:requirement "Performance: 선택" ;
    hmv:usedInClass hmv:Performance .

hmv:definitionStatus a owl:AnnotationProperty ;
    rdfs:label "관계정의 상태"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> .

hmv:derivation_basis a owl:AnnotationProperty ;
    rdfs:label "도출 근거"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> .

hmv:derivative_use_allowed a owl:DatatypeProperty ;
    rdfs:label "2차적 활용가능여부"@ko ;
    rdfs:comment "Licence: 변형, 편집 또는 파생 콘텐츠 제작을 허용하는지 여부"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:accessRights ;
    skos:relatedMatch crm:E55_Type ;
    hmv:cidocCrmMapping "Licence: E55 Type" ;
    hmv:fieldSource "스키마 시트 4차" ;
    hmv:inputType "Licence: boolean" ;
    hmv:requirement "Licence: 선택" ;
    hmv:usedInClass hmv:Licence .

hmv:description a owl:DatatypeProperty ;
    rdfs:label "공정설명"@ko,
        "권리설명"@ko,
        "동작설명"@ko,
        "라이선스설명"@ko,
        "설명"@ko,
        "실연설명"@ko,
        "애셋설명"@ko,
        "요소세부설명"@ko,
        "재료설명"@ko,
        "주체설명"@ko ;
    rdfs:comment "Agent: 해당 개인 또는 조직의 일반적 성격과 활동 맥락을 설명하는 서술"@ko,
        "Asset: 자산의 기록대상과 생산방법 및 구성 특성을 명사형 한 줄로 서술"@ko,
        "DigitalProject: 디지털 작업의 목적, 범위 및 기술적 맥락에 관한 설명"@ko,
        "Heritage: 유산의 역사와 제작과정 및 전승의 특성을 설명하는 서술"@ko,
        "Item: 해당 파일의 대상과 내용 및 역할을 명사형 한 줄로 서술"@ko,
        "Licence: 이용허락의 적용 맥락과 범위에 대한 보충 설명"@ko,
        "Materials: 재료의 특징과 제작공정 및 직조동작에서 수행하는 기능을 기술한 설명"@ko,
        "Movement: 실연자의 행위와 작동 도구 및 대상 재료의 변화를 기술한 설명"@ko,
        "Performance: 실연 목적과 실연 범위 및 촬영 특징에 관한 설명"@ko,
        "Process: 공정의 수행 방식과 입력재료 및 산출재료의 변화를 기술한 설명"@ko,
        "Right: 권리의 적용 조건, 보유 상태, 권리이전 경위 또는 예외사항을 보충하여 기술한 설명"@ko,
        "Tool: 도구와 부재의 구조, 기능 및 제작과정에서의 사용 목적을 기술한 설명"@ko ;
    rdfs:isDefinedBy <https://w3id.org/hansan-mosi/vocab> ;
    rdfs:subPropertyOf dcterms:description ;
    skos:relatedMatch crm:E62_String ;
    hmv:cidocCrmMapping "Agent: E62 String",
        "Asset: E62 String",
        "DigitalProject: E62 String",
        "Heritage: E62 String",
        "Item: E62 String",
        "Licence: E62 String",
        "Materials: E62 String",
        "Movement: E62 String",
        "Performance: E62 String",
        "Process: E62 String",
        "Right: E62 String",
        "Tool: E62 String" ;
    hmv:fieldSource "스키마 시트 4차" ;
